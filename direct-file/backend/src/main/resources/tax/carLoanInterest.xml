<?xml-model href="./FactDictionaryModule.rng"?>
<FactDictionaryModule>
  <Facts>

    <!-- OBBBA Car Loan Interest Deduction (Schedule 1 adjustment) -->
    <!-- Taxpayers may deduct interest paid on qualifying auto loans, up to $10,000 -->
    <!-- For MFJ, each filer may deduct up to $10,000 (total $20,000) -->

    <Fact path="/maxCarLoanInterestDeductionIndividual">
      <Description>Maximum car loan interest deduction per individual for TY2025</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>10000</Dollar>
      </Derived>
    </Fact>

    <Fact path="/hadCarLoanInterestPayments">
      <Name>Had car loan interest payments</Name>
      <Description>Whether the taxpayer paid interest on a qualifying car loan in the tax year</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/carLoanIsQualified">
      <Name>Car loan is qualified</Name>
      <Description>Whether the car loan meets the OBBBA qualification criteria: must be for a vehicle
        manufactured or assembled in the United States, and the loan must have been originated by a
        US-based lender</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/flowShowCarLoanInterestSection">
      <Description>Whether to show the car loan interest deduction section based on not being an MFJ dependent</Description>
      <Derived>
        <Not>
          <Dependency module="filingStatus" path="/isMFJDependent" />
        </Not>
      </Derived>
    </Fact>

    <Fact path="/flowShowCarLoanInterestAmount">
      <Description>Whether to show the car loan interest amount input</Description>
      <Derived>
        <All>
          <Dependency path="/hadCarLoanInterestPayments" />
          <Dependency path="/carLoanIsQualified" />
        </All>
      </Derived>
    </Fact>

    <Fact path="/carLoanInterestAmountPrimary">
      <Name>Car loan interest amount (primary filer)</Name>
      <Description>Amount of car loan interest paid by the primary filer</Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/carLoanInterestAmountSecondary">
      <Name>Car loan interest amount (secondary filer)</Name>
      <Description>Amount of car loan interest paid by the secondary filer (MFJ only)</Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/carLoanInterestDeductionPrimary">
      <Description>Car loan interest deduction for primary filer, capped at max</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Dependency path="/flowShowCarLoanInterestAmount" />
            </When>
            <Then>
              <LesserOf>
                <Dependency path="/carLoanInterestAmountPrimary" />
                <Dependency path="/maxCarLoanInterestDeductionIndividual" />
              </LesserOf>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/carLoanInterestDeductionSecondary">
      <Description>Car loan interest deduction for secondary filer, capped at max (MFJ only)</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <All>
                <Dependency path="/flowShowCarLoanInterestAmount" />
                <Dependency module="filingStatus" path="/isFilingStatusMFJ" />
              </All>
            </When>
            <Then>
              <LesserOf>
                <Dependency path="/carLoanInterestAmountSecondary" />
                <Dependency path="/maxCarLoanInterestDeductionIndividual" />
              </LesserOf>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/carLoanInterestAdjustment">
      <Name>Car Loan Interest Adjustment</Name>
      <Description>Total car loan interest deduction for Schedule 1. Sum of primary and secondary filer deductions.</Description>
      <Export downstreamFacts="true" mef="true" />
      <Derived>
        <Round>
          <Add>
            <Dependency path="/carLoanInterestDeductionPrimary" />
            <Dependency path="/carLoanInterestDeductionSecondary" />
          </Add>
        </Round>
      </Derived>
    </Fact>

  </Facts>
</FactDictionaryModule>
